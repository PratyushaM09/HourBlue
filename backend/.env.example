# Copy to .env for local dev (docker-compose reads this automatically).
# Never commit the real .env - it's already in .gitignore.

# --- Database (matches docker-compose.yml mysql service) ---
DB_URL=jdbc:mysql://mysql:3306/hourblue
DB_USERNAME=hourblue
DB_PASSWORD=hourblue_local_dev

# MySQL container itself (docker-compose.yml)
MYSQL_ROOT_PASSWORD=root_local_dev
MYSQL_DATABASE=hourblue
MYSQL_USER=hourblue
MYSQL_PASSWORD=hourblue_local_dev

# --- JWT ---
# Generate a real random 32+ byte string for anything beyond local dev,
# e.g.: openssl rand -base64 48
JWT_SECRET=local-dev-only-change-this-to-a-long-random-string-min-32-bytes
JWT_EXPIRATION_MS=3600000

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Cloudinary (from your Cloudinary dashboard) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- One-time admin account seed (Section 9.1) ---
# Set these, start the backend once so the admin_user row is created, then
# clear these two values (the seeder never overwrites an existing account).
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=
